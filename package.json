{
  "name": "ds-bot",
  "version": "0.1.0",
  "description": "",
  "type": "commonjs",
  "author": "Vadim Pashkov <vadimpashkov.job@gmail.com> (https://github.com/vadimpashkov)",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "npx biome lint --write",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false",
    "format": "npx biome format --write",
    "check": "npx biome check --write",
    "migrate:up": "dotenv -e .env -- node-pg-migrate up",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.ts,json": "biome check --fix"
  },
  "dependencies": {
    "discord.js": "^14.19.0",
    "dotenv": "^17.4.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.16.5",
    "typescript": "^7.0.2"
  }
}
