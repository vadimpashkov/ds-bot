DISCORD_TOKEN=

GUILD_ID=

OWNER_ID=

ADMIN_ROLE_ID=
MODERATOR_ROLE_ID=
SUPPORT_ROLE_ID=
BOT_ROLE_ID=

PREFIX=!

# Путь к файлу со сводом правил (внутри контейнера 0 см. volume в docker-compose.yml)
RULES_PATH=./data/rules.json

# Уровень логирования: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# development | production 0 влияет на формат логов (pretty vs json)
NODE_ENV=production

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# DATABASE_URL=postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
